{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "enabledMcpjsonServers": ["maestro"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-check.sh",
            "timeout": 120,
            "statusMessage": "Lint + typecheck"
          }
        ]
      }
    ]
  }
}
