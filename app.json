{
  "expo": {
    "name": "Hourfolio",
    "slug": "hourfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hourfolio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/hourfolio.icon",
      "bundleIdentifier": "com.ms4ever7.hourfolio",
      "appleTeamId": "2RMJ37733D",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15171A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ms4ever7.hourfolio"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F2ED",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-localization",
      "./plugins/with-scene-lifecycle",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hourfolio uses your photos only for the pictures you pick for your profile and assets. They stay on this device."
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Pumpkin",
            "ios": "./assets/images/app-icons/pumpkin.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/pumpkin-android-foreground.png",
              "backgroundColor": "#1B0F2E"
            }
          },
          {
            "name": "Winter",
            "ios": "./assets/images/app-icons/winter.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/winter-android-foreground.png",
              "backgroundColor": "#10243A"
            }
          }
        ]
      ],
      "./plugins/without-push-entitlement"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b8387471-8b97-49e7-baf3-32d6ce840a91"
      }
    },
    "owner": "mszorro"
  }
}
