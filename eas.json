{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "APP_VARIANT": "development" }
    },
    "staging": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "staging",
      "env": { "APP_VARIANT": "staging" }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "env": { "APP_VARIANT": "production" }
    }
  },
  "submit": {
    "staging": { "ios": { "ascAppId": "6819194688" } },
    "production": { "ios": { "ascAppId": "6819192771" } }
  }
}
